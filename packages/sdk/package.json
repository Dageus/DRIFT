{
  "name": "@drift-network/sdk",
  "version": "0.1.0",
  "description": "SDK for the DRIFT decentralized reputation protocol",
  "author": "Dageus",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.10.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./engines": {
      "import": "./dist/engines/index.js",
      "types": "./dist/engines/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./trust": {
      "import": "./dist/trust/index.js",
      "types": "./dist/trust/index.d.ts"
    },
    "./merkle": {
      "import": "./dist/merkle/index.js",
      "types": "./dist/merkle/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:e2e": "vitest run"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "^1.0.8",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
